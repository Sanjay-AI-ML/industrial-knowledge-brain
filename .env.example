# ============================================================
# Industrial Knowledge Brain — environment template
#
# Copy this file to `.env` in the PROJECT ROOT (one file for
# Docker Compose AND local `uvicorn` dev — no backend/.env).
# NEVER commit the real `.env`. Secrets stay here only.
# ============================================================

# --- App ---
APP_NAME="Industrial Knowledge Brain"
APP_ENV=development                # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Google Gemini (LLM + entity extraction) — REQUIRED ---
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=4096
LLM_PROVIDER=gemini

# --- Neo4j ---
# Default works with the bundled Docker Neo4j container (profile local-neo4j).
# To use managed AuraDB instead, uncomment and fill in NEO4J_URI / credentials.
# NEO4J_URI=neo4j+s://REPLACE_ME.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=REPLACE_ME
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ikb_password
NEO4J_LOCAL_PASSWORD=ikb_password   # password for the bundled local Neo4j container

# --- ChromaDB (local persistent) ---
CHROMA_PERSIST_DIR=./data/chroma_persist
CHROMA_COLLECTION_NAME=documents

# --- PostgreSQL + pgvector (Supabase) — optional, future use ---
POSTGRES_HOST=db.REPLACE_ME.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_SSLMODE=require

# --- OCR fallback (document parser) ---
OCR_FALLBACK_ENABLED=true
OCR_LANGUAGE=eng
OCR_MIN_TEXT_LEN=20

# --- Voice (Bhashini + faster-whisper) ---
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/v1/translate
BHASHINI_API_KEY=REPLACE_ME
BHASHINI_USER_ID=REPLACE_ME
WHISPER_MODEL_SIZE=small            # tiny | base | small | medium | large
WHISPER_DEVICE=cpu                  # cpu | cuda
WHISPER_COMPUTE_TYPE=int8

# --- Auth (JWT) ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080            # 7 days
